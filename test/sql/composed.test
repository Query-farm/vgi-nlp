# name: test/sql/composed.test
# group: [vgi_nlp]
#
# Composed example queries (vgi_nlp/composed.py) and the composed agent-test graders
# (vgi-agent-tests.yaml), asserted row-for-row. The SQL lines are copied verbatim from
# those sources; tests/test_composed.py fails if they drift apart.

require-env VGI_NLP_WORKER

statement ok
LOAD vgi;

statement ok
ATTACH 'nlp' AS nlp (TYPE vgi, LOCATION '{VGI_NLP_WORKER}');

# ---- WORST_SENTENCE_PER_REVIEW ----

query ITR
WITH reviews(id, body) AS (VALUES (1, 'The hotel location was perfect. The room was filthy and the staff were rude. Breakfast was fine.'), (2, 'Checkout was a frustrating mess. Otherwise it was a wonderful stay with a lovely view!')) SELECT id, arg_min(sentence, nlp.main.sentiment(sentence)) AS worst_sentence, round(min(nlp.main.sentiment(sentence)), 3) AS worst_score FROM nlp.main.sentences((SELECT id, body FROM reviews), id := 'id', lang := 'en') GROUP BY id ORDER BY id;
----
1	The room was filthy and the staff were rude.	-0.459
2	Checkout was a frustrating mess.	-0.66

# ---- SENTIMENT_PER_ORGANIZATION ----

query TIR
WITH reviews(id, body) AS (VALUES (1, 'I love my new Apple laptop, the battery life is amazing.'), (2, 'Microsoft support was awful and rude.'), (3, 'The Apple store staff were friendly and quick to help.'), (4, 'Microsoft keeps crashing my laptop, which is incredibly frustrating.')) SELECT e.ent_text AS organization, count(*) AS mentions, round(avg(nlp.main.sentiment(r.body)), 3) AS avg_sentiment FROM nlp.main.entities((SELECT id, body FROM reviews), id := 'id', lang := 'en') AS e JOIN reviews AS r USING (id) WHERE e.label = 'ORG' GROUP BY e.ent_text ORDER BY avg_sentiment DESC;
----
Apple	2	0.775
Microsoft	2	-0.502

# ---- LANGUAGE_ROUTING ----

query ITTT
WITH docs(id, body) AS (VALUES (1, 'The quarterly report shows strong growth in every region.'), (2, 'Le rapport trimestriel montre une forte croissance dans toutes les régions.'), (3, 'Ripoti ya robo mwaka inaonyesha ukuaji mkubwa katika kila mkoa.')), detected AS (SELECT id, nlp.main.detect_lang(body) AS lang FROM docs) SELECT d.id, d.lang, s.spacy_model, s.spacy_model IS NOT NULL AS has_default_pipeline FROM detected AS d LEFT JOIN nlp.main.supported_languages AS s ON s.lang_code = d.lang ORDER BY d.id;
----
1	en	en_core_web_sm	true
2	fr	fr_core_news_sm	true
3	sw	NULL	false

# ---- NEGATIVE_REVIEW_ASPECTS ----

query TI
WITH reviews(id, body) AS (VALUES (1, 'The rooms were dirty and the beds were terrible.'), (2, 'Awful service, and the room smelled bad.'), (3, 'The beds were comfortable and the view was great.'), (4, 'The breakfast was cold and the coffee was disgusting.')) SELECT nlp.main.lemmatize(lower(root), 'en') AS aspect, count(DISTINCT id) AS negative_reviews FROM nlp.main.noun_chunks((SELECT id, body FROM reviews WHERE nlp.main.sentiment_label(body) = 'neg'), id := 'id', lang := 'en') GROUP BY aspect ORDER BY negative_reviews DESC, aspect;
----
room	2
bed	1
breakfast	1
coffee	1
service	1

# ---- grader: most-negative-sentence-index ----

query I
SELECT arg_min(sent_index, nlp.main.sentiment(sentence)) AS worst_index FROM nlp.main.sentences((SELECT 'Our flight left on time. The seats were broken and the crew was hostile. The snacks were tasty.' AS body), lang := 'en');
----
1

# ---- grader: count-texts-with-default-pipeline ----

query I
SELECT count(*) AS n_supported FROM (VALUES ('The weather is lovely today and we are going to the beach.'), ('Das Wetter ist heute schön und wir fahren an den Strand.'), ('Cuaca hari ini sangat cerah dan kami akan pergi ke pantai bersama keluarga.'), ('Bugün hava çok güzel ve sahile gidiyoruz.')) AS v(t) JOIN nlp.main.supported_languages AS s ON s.lang_code = nlp.main.detect_lang(v.t);
----
2
